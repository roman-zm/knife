{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Flutter App",
			"type": "dart",
			"request": "launch",
			"program": "lib/main.dart",
			"flutterMode": "debug",
			"cwd": "${workspaceFolder}/example",
		},
		{
			"name": "Debug generator",
			"type": "dart",
			"request": "launch",
			"cwd": "${workspaceFolder}/example/",
			"program": ".dart_tool/build/entrypoint/build.dart",
			"args": [
				"build",
				"--delete-conflicting-outputs"
			]
		}
	]
}